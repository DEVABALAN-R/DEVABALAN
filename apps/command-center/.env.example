# Public values only: they are embedded in the app bundle. Row Level Security protects the data.
# Find them in Supabase → Project Settings → API. Never put a secret or service-role key here.
EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_YOUR_KEY
